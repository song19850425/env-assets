  "qualitative": [
    {
      "key": "purge-trap-temperature",
      "text": "吹扫温度：室温或恒温。其余参数参照仪器使用说明书进行设定。",
      "citation": "HJ 639-2012 第 8.1.1 条"
    },
    {
      "key": "bottle-precleaning",
      "text": "采集样品时，应使水样在样品瓶中溢流而不留空间；取样时应尽量避免或减少样品在空气中暴露。注：样品瓶应在采样前用甲醇清洗，采样时不需用样品进行荡洗。",
      "citation": "HJ 639-2012 第 7.1 条及注 2"
    },
    {
      "key": "replicate-requirement",
      "text": "所有样品均采集平行双样，每批样品应带一个全程序空白和一个运输空白。",
      "citation": "HJ 639-2012 第 7.1 条"
    },
    {
      "key": "bubble-discard",
      "text": "当水样加盐酸溶液后产生大量气泡时，应弃去该样品，重新采集样品。",
      "citation": "HJ 639-2012 第 7.2 条"
    },
    {
      "key": "xylene-sum",
      "text": "使用本标准中规定的毛细管柱时，间二甲苯和对二甲苯的测定结果为两者之和。",
      "citation": "HJ 639-2012 第 9.3.2 条"
    },
    {
      "key": "quantitation-method",
      "text": "目标化合物的定量可用平均相对响应因子定量，也可用校准曲线定量；定性分析须建立保留时间窗，并核对定量离子与辅助离子（SIM 方式）或标准质谱图丰度高于 30% 的所有离子（全扫描方式）。",
      "citation": "HJ 639-2012 第 9.1、9.2 条"
    }
  ]
}
