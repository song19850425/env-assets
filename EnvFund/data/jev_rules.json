{
  "version": "1.2.0",
  "scope": "仅适用中央级与省级生态环境资金申报指南；市县级、区县级指南不在本规则库适用范围内。",
  "description": "JEV 硬规则终审库。规则只吃词表命中，不吃 LLM 判断。",
  "priority": ["EXCLUDE", "FORCE", "WEIGHT"],
  "labels": {
    "WATER": "水生态水环境",
    "AIR": "大气污染防治",
    "SOIL": "土壤污染防治",
    "GROUNDWATER": "地下水污染防治",
    "SOLID": "固体废物污染治理",
    "RURAL": "农村生态环境整治",
    "MOUNTAIN": "山水林田湖草沙生态修复",
    "CLIMATE": "应对气候变化/减污降碳协同",
    "CAPACITY": "环境监测能力建设/智慧环保",
    "NUCLEAR": "核与辐射安全",
    "INDUSTRY": "环保产业/绿色金融配套"
  },
  "labels_note": "以下 labels 为规则可判定的标签池。UNCERTAIN 不参与规则判定，由语义层直接给出。",

  "FORCE": [
    {
      "id": "F-WATER-01",
      "label": "WATER",
      "any": ["流域治理", "河道整治", "水生态修复", "清水廊道", "河湖生态修复", "湖库治理", "生态护岸", "滨水缓冲带"],
      "note": "流域/河湖水生态类"
    },
    {
      "id": "F-WATER-02",
      "label": "WATER",
      "any": ["黑臭水体", "入河排污口", "入河排污口整治", "水环境提质增效"]
    },
    {
      "id": "F-WATER-03",
      "label": "WATER",
      "any": ["水源地保护", "饮用水水源", "水源涵养", "滨水带修复", "富营养化", "水华防治", "蓝藻"]
    },
    {
      "id": "F-WATER-04",
      "label": "WATER",
      "any": ["雨污分流", "水系连通", "生态清淤", "底泥疏浚"],
      "none_strict": ["黑臭水体", "入河排污口", "水生态", "水质提升", "水体治理", "断面", "河湖", "流域"],
      "note": "手段词规则：雨污分流/水系连通等本身只是工程手段，须有「肯定形式」的水体治理目标词才算数。用 none_strict 而非 none——「不涉及水体治理」这种否定表述不能算作目标存在。"
    },

    {
      "id": "F-AIR-01",
      "label": "AIR",
      "any": ["美丽蓝天", "大气污染防治", "大气环境治理", "空气质量改善", "大气污染物", "空气质量管理"],
      "note": "官方资金赛道总称。词表取自中央生态环境资金入库指南与大气污染防治资金管理办法原文表述。"
    },
    {
      "id": "F-AIR-02",
      "label": "AIR",
      "any": ["VOCs", "挥发性有机物", "氮氧化物", "二氧化硫", "颗粒物治理", "超低排放", "工业炉窑", "炉窑"],
      "note": "工业源与污染物类"
    },
    {
      "id": "F-AIR-03",
      "label": "AIR",
      "any": ["燃煤锅炉", "锅炉综合治理", "锅炉淘汰", "清洁能源替代", "燃气锅炉", "生物质锅炉", "散煤治理", "散煤", "清洁取暖", "冬季清洁取暖"],
      "note": "燃煤污染控制与锅炉综合治理"
    },
    {
      "id": "F-AIR-04",
      "label": "AIR",
      "any": ["移动源污染治理", "非道路移动机械", "机动车尾气", "营运货车", "扬尘污染", "重污染天气", "联防联控", "恶臭气体", "秸秆禁烧"],
      "note": "移动源与其他面源"
    },

    {
      "id": "F-SOIL-01",
      "label": "SOIL",
      "any": ["建设用地土壤", "土壤污染调查", "土壤污染状况调查", "土壤风险管控", "土壤污染风险管控", "污染地块", "土壤修复", "土壤污染修复", "风险管控与修复", "受污染建设用地"]
    },
    {
      "id": "F-SOIL-02",
      "label": "SOIL",
      "any": ["农用地土壤", "耕地安全利用", "耕地分类管控", "受污染耕地", "农用地安全利用", "农用地土壤污染源整治"]
    },
    {
      "id": "F-SOIL-03",
      "label": "SOIL",
      "any": ["场地污染溯源", "土壤环境调查评估", "土壤环境监测", "土壤污染源头防控", "受污染农用地", "农用地土壤污染溯源", "源头管控"],
      "note": "须与污染类词共现"
    },

    {
      "id": "F-GW-01",
      "label": "GROUNDWATER",
      "any": ["地下水污染", "地下水环境调查", "地下水羽带", "羽状污染"],
      "note": "地下水专属最强锚点"
    },
    {
      "id": "F-GW-02",
      "label": "GROUNDWATER",
      "any": ["地下水监测井", "地下水抽注", "防渗阻隔", "地下水阻隔墙"]
    },
    {
      "id": "F-GW-03",
      "label": "GROUNDWATER",
      "any": ["渣场渗漏", "堆场渗漏", "渗漏治理"],
      "note": "须与地下水/渗滤液共现，否则可能归固废"
    },

    {
      "id": "F-SOLID-01",
      "label": "SOLID",
      "any": ["危废", "危险废物", "一般工业固废", "固废堆场", "规范化贮存"]
    },
    {
      "id": "F-SOLID-02",
      "label": "SOLID",
      "any": ["历史遗留废渣", "尾矿库", "煤矸石", "堆体稳定化", "固废清运"]
    },
    {
      "id": "F-SOLID-03",
      "label": "SOLID",
      "any": ["垃圾填埋场", "存量垃圾", "填埋场封场", "渗滤液处理"]
    },

    {
      "id": "F-RURAL-01",
      "label": "RURAL",
      "any": ["农村生活污水", "农村生活垃圾", "农村黑臭水体", "农村污水", "农村垃圾", "改厕", "户厕改造"]
    },
    {
      "id": "F-RURAL-02",
      "label": "RURAL",
      "any": ["村容村貌", "农村人居环境", "畜禽养殖污染", "村庄生态宜居", "美丽乡村建设", "村庄生活空间", "村庄生态空间", "水源涵养及生态带"]
    },
    {
      "id": "F-RURAL-03",
      "label": "RURAL",
      "any": ["农业面源污染", "水产养殖污染", "农田退水"],
      "note": "农业面源类，词表取自中央生态环境资金入库指南原文"
    },

    {
      "id": "F-MTN-01",
      "label": "MOUNTAIN",
      "any": ["矿山生态修复", "边坡生态治理", "废弃矿山", "历史遗留矿山"]
    },
    {
      "id": "F-MTN-02",
      "label": "MOUNTAIN",
      "any": ["林地修复", "草地修复", "湿地修复", "生态屏障", "国土综合整治",
              "水土流失治理", "石漠化治理", "荒漠化治理", "退化林", "退化草",
              "生物多样性保护", "植被恢复"],
      "note": "生态修复类锚点，经真实语料回归补充"
    },
    {
      "id": "F-MTN-03",
      "label": "MOUNTAIN",
      "any": ["山水林田湖草沙", "山水林田湖草"],
      "note": "一体化保护治理类，最高置信度锚点"
    },

    {
      "id": "F-CLIMATE-01",
      "label": "CLIMATE",
      "any": ["减污降碳", "碳达峰", "碳中和", "温室气体", "甲烷排放控制"]
    },
    {
      "id": "F-CLIMATE-02",
      "label": "CLIMATE",
      "any": ["低碳试点", "气候适应", "碳排放核算"]
    },

    {
      "id": "F-CAPACITY-01",
      "label": "CAPACITY",
      "any": ["环境监测能力", "监测网络建设", "智慧环保", "污染源在线监控", "自动监测站", "监测监管能力", "监管能力建设", "水生态环境监管", "大气环境监测监管"]
    },
    {
      "id": "F-CAPACITY-02",
      "label": "CAPACITY",
      "any": ["执法能力建设", "应急监测", "环境信息化平台", "监测执法设备", "源解析", "排放清单编制"]
    },

    {
      "id": "F-NUCLEAR-01",
      "label": "NUCLEAR",
      "any": ["核与辐射", "辐射环境监测", "放射性废物", "电磁辐射"]
    },

    {
      "id": "F-INDUSTRY-01",
      "label": "INDUSTRY",
      "any": ["环保产业", "绿色金融", "EOD", "生态环境导向的开发"]
    }
  ],

  "EXCLUDE": [
    {
      "id": "X-WATER-01",
      "label": "WATER",
      "all": ["管网"],
      "none": ["黑臭水体", "入河排污口", "水生态", "水质提升", "水体治理", "断面", "农村", "村庄", "乡村", "农村生活污水"],
      "note": "仅管网建设、无水体治理目标 → 不打水环境主标。none 须含农村场景保护词——农村污水管网属农村赛道，不能被水环境排除规则拿走。"
    },
    {
      "id": "X-WATER-02",
      "label": "WATER",
      "all": ["工业废水"],
      "any": ["提标改造", "废水处理站", "企业内部"],
      "none": ["流域", "区域水质", "入河排污口"],
      "note": "仅企业废水站提标，不占水环境专项资金赛道"
    },
    {
    "id": "X-AIR-01",
    "label": "AIR",
    "all": ["节能"],
    "none": ["VOCs", "挥发性有机物", "氮氧化物", "二氧化硫", "颗粒物", "排放", "烟气", "超低排放", "锅炉", "炉窑", "燃煤", "清洁取暖", "美丽蓝天"],
    "note": "单纯设备节能、不针对大气污染物排放 → 剔除。none 保护词须覆盖办法正文常见的大气治理表述，避免在「管理办法」文体中误触发。"
  },
  {
    "id": "X-AIR-02",
    "label": "AIR",
    "all": ["技术改造", "技改"],
    "none": ["排放", "污染物", "脱硫", "脱硝", "除尘", "超低排放", "锅炉", "炉窑", "燃煤", "VOCs", "挥发性有机物"],
    "note": "单纯技改 → 剔除。"
  },
    {
      "id": "X-SOIL-01",
      "label": "SOIL",
      "all": ["绿化"],
      "none": ["污染", "风险管控", "修复"],
      "note": "单纯绿化 → 剔除"
    },
    {
      "id": "X-SOIL-02",
      "label": "SOIL",
      "all_group": ["土方", "平整场地", "场地平整"],
      "none": ["污染", "修复"],
      "note": "非污染治理类土方工程 → 剔除"
    },
    {
      "id": "X-GW-01",
      "label": "GROUNDWATER",
      "all": ["地表水"],
      "none": ["地下水", "监测井", "防渗", "羽带", "阻隔"],
      "note": "仅地表水治理、无地下水要素 → 不得打地下水标签"
    },
    {
      "id": "X-SOLID-01",
      "label": "SOLID",
      "all": ["资源化"],
      "any": ["工厂", "生产线", "生产装置", "产业项目"],
      "none": ["存量", "历史遗留", "堆场", "填埋场", "整治"],
      "note": "单纯资源化工厂建设 → 不纳入固废治理专项资金"
    },
    {
      "id": "X-RURAL-01",
      "label": "RURAL",
      "all_group": ["城镇", "城市", "市政"],
      "any": ["城镇生活污水", "城镇污水", "市政污水", "环卫", "垃圾处理", "垃圾转运站", "垃圾填埋场", "垃圾焚烧", "城镇垃圾", "雨污分流"],
      "none": ["农村", "村庄", "乡村"],
      "note": "城镇工程 → 剔除农村赛道。any 须用「城镇污水/城镇垃圾」等限定词，不可用裸词「污水」——城区污水管网项目会误命中；设施名须逐一列出，因设施名里不含「垃圾处理」四字。"
    }
  ],

  "WEIGHT": {
    "note": "主/协同赛道裁决。仅在 FORCE 通过、EXCLUDE 未命中后执行。第一匹配生效，顺序即优先级——把最具体的组合放前面。",
    "rules": [
      { "id": "W-01", "when": ["MOUNTAIN", "GROUNDWATER"], "primary": "MOUNTAIN", "secondary": "GROUNDWATER", "note": "矿山/流域系统修复中的地下水配套，主赛道归生态修复" },
      { "id": "W-02", "when": ["MOUNTAIN", "SOIL"], "primary": "MOUNTAIN", "secondary": "SOIL", "note": "矿山修复含土壤治理，系统修复优先" },
      { "id": "W-03", "when": ["RURAL", "WATER"], "primary": "RURAL", "secondary": "WATER", "note": "农村场景优先锁农村，水为协同" },
      { "id": "W-04", "when": ["RURAL", "SOLID"], "primary": "RURAL", "secondary": "SOLID" },
      { "id": "W-05", "when": ["RURAL"], "primary": "RURAL", "secondary": "*", "note": "农村场景优先锁农村，再叠加子标签" },
      { "id": "W-06", "when": ["WATER", "GROUNDWATER"], "primary": "WATER", "secondary": "GROUNDWATER", "note": "水环境专项中含地下水配套，主赛道归水环境" },
      { "id": "W-07", "when": ["GROUNDWATER", "SOIL"], "primary": "SOIL", "secondary": "GROUNDWATER", "note": "纯污染地块场景：土壤为主、地下水协同" },
      { "id": "W-08", "when": ["SOLID", "SOIL"], "primary": "SOLID", "secondary": "SOIL" },
      { "id": "W-09", "when": ["WATER", "MOUNTAIN"], "primary": "WATER", "secondary": "MOUNTAIN" },
      { "id": "W-10", "when": ["CLIMATE", "AIR"], "primary": "AIR", "secondary": "CLIMATE" },
      { "id": "W-11", "when": ["CAPACITY", "AIR"], "primary": "AIR", "secondary": "CAPACITY", "note": "能力建设是配套赛道：与实体治理赛道共现时退为协同，主线归实体治理。原规则「CAPACITY 通吃」会让大气办法的主赛道错判为能力建设。" },
      { "id": "W-12", "when": ["CAPACITY", "WATER"], "primary": "WATER", "secondary": "CAPACITY", "note": "同上：监管能力建设配套水环境治理" },
      { "id": "W-13", "when": ["CAPACITY", "RURAL"], "primary": "RURAL", "secondary": "CAPACITY" },
      { "id": "W-14", "when": ["CAPACITY", "MOUNTAIN"], "primary": "MOUNTAIN", "secondary": "CAPACITY" },
      { "id": "W-15", "when": ["CAPACITY", "SOIL"], "primary": "SOIL", "secondary": "CAPACITY" },
      { "id": "W-16", "when": ["CAPACITY", "GROUNDWATER"], "primary": "GROUNDWATER", "secondary": "CAPACITY" },
      { "id": "W-17", "when": ["CAPACITY"], "primary": "CAPACITY", "secondary": "*", "note": "兜底：仅当无任何实体治理赛道时，能力建设才作主赛道" }
    ],
    "fallthrough": {
      "note": "无匹配权重规则时：单标签直接定主；多标签按 FORCE 规则命中条数定主（多者为优），条数并列则标记 FALLTHROUGH_MULTI_TIE 进人工复核队列。"
    }
  }
}
